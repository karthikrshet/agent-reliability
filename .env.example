# ─────────────────────────────────────────────────────────────────────────────
# Agent Reliability Lab — Environment Configuration
#
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env with real values.
# All secrets should be managed through your secret manager in production.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
ARL_ENV=development              # development | staging | production
ARL_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
ARL_SECRET_KEY=REPLACE_WITH_32_BYTE_RANDOM_SECRET
ARL_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arl
POSTGRES_USER=arl
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Async DSN (used by SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://arl:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/arl

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── API ─────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1               # Bind to loopback in dev. WARNING: Never expose without auth.
API_PORT=8000
API_WORKERS=1                    # For production, set to CPU count

# ─── Worker ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_LEASE_TTL_SECONDS=300
WORKER_MAX_RETRIES=3

# ─── OpenTelemetry ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agent-reliability-lab
OTEL_ENABLED=false              # Set to true to enable telemetry

# ─── Model providers (for model-based graders ONLY — never for agent under test) ──
# These are optional and only used by the evaluation system's judge models.
# OPENAI_API_KEY=REPLACE_WITH_KEY
# ANTHROPIC_API_KEY=REPLACE_WITH_KEY

# ─── Dashboard ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
DASHBOARD_PORT=3000

# ─── Development flags ────────────────────────────────────────────────────────
# WARNING: These flags weaken security controls. Never enable in production.
ARL_ALLOW_LOCALHOST_TARGETS=true    # Allow agent targets on localhost
ARL_SKIP_SSRF_CHECKS=false          # Never set to true in production
ARL_DEV_SHOW_SQL=false              # Log SQL queries (verbose)
